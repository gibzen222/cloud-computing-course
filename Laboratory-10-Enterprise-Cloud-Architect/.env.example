# Copy this file to .env and replace every value with your own strong passwords:
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
# The real .env file is listed in .gitignore and must NEVER be pushed to GitHub.

DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=change_me_app_password
DB_ROOT_PASSWORD=change_me_root_password
